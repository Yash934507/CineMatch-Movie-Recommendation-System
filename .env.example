# Private configuration: keep real values in the local environment or deployment secret manager.
# Never commit real credentials or database passwords.
CINEMATCH_ENV=development
CINEMATCH_DATABASE_URL=sqlite:///./data/cinematch.db
CINEMATCH_READ_ONLY_DEMO=false
CINEMATCH_HOST=0.0.0.0
CINEMATCH_PORT=8000
CINEMATCH_LOG_LEVEL=INFO
CINEMATCH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# Public application paths and runtime behavior.
CINEMATCH_MODEL_PATH=models/svd_model.pkl
CINEMATCH_DATA_PATH=data
CINEMATCH_FRONTEND_PATH=frontend/dist
CINEMATCH_ENABLE_DOCS=true
CINEMATCH_REQUEST_TIMEOUT_SECONDS=30.0
CINEMATCH_SLOW_REQUEST_MS=500

# Production note:
# - Set CINEMATCH_DATABASE_URL to a non-SQLite URL in deployment, managed outside the repo.
# - The approved public demo is the exception: set CINEMATCH_READ_ONLY_DEMO=true and use an isolated ephemeral SQLite database.
# - Read-only demo mode blocks account/session/data writes; the stateless onboarding recommendation request remains enabled.
# - Keep frontend-only values in Vite env files, not in server-side secrets.
